# SmartFlow — environment variables.
# Copy to .env (gitignored) and fill in real values. Never commit secrets.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/smartflow_db
DB_USERNAME=smartflow_user
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram bot
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Docker Compose: server host + n8n basic auth
SERVER_HOST=localhost
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_PROTOCOL=http
